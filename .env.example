# LLM_PROVIDER=anthropic uses Claude + OpenAI embeddings (keys below).
# LLM_PROVIDER=local uses an OpenAI-compatible server (LM Studio / Ollama) for both; no keys.
LLM_PROVIDER=anthropic
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MODEL_STRONG=claude-sonnet-5
MODEL_FAST=claude-haiku-4-5-20251001
EMBED_MODEL=text-embedding-3-small
EMBED_PREFIX=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_MOCK=0
